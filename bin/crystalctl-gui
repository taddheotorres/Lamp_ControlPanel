#!/usr/bin/env python3
"""
CRYSTAL//CTL panel: a local web UI for the services in crystal_core.

The server binds to 127.0.0.1 only, and every API call must carry the per-launch token and a
127.0.0.1 Host header, so other websites (or DNS-rebinding tricks) cannot start, stop or install anything.
"""

import hmac
import json
import os
import secrets
import shlex
import shutil
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [os.path.join(HERE, "..", "lib"), "/usr/local/lib/crystalctl"]
import crystal_core as core  # noqa: E402

PANEL_PATHS = [os.path.join(HERE, "..", "gui", "panel.html"), "/usr/local/share/crystalctl/panel.html"]
SETTINGS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                        "crystalctl", "settings.json")
IDLE_EXIT_SECONDS = 45  # the page pings every 5 s; no ping for this long means the window was closed


class Console:
    """Shared output log that the page polls; actions run in threads and append to it."""

    def __init__(self):
        self.lines, self.lock, self.task = [], threading.Lock(), threading.Lock()

    @property
    def busy(self):
        return self.task.locked()

    def add(self, text, tag="sys"):
        with self.lock:
            for line in str(text).rstrip().splitlines() or [""]:
                self.lines.append({"t": time.strftime("%H:%M:%S"), "tag": tag, "text": line})
            del self.lines[:-2000]

    def since(self, n):
        with self.lock:
            return len(self.lines), self.lines[n:] if n <= len(self.lines) else self.lines[-200:]


class DemoRunner(core.Runner):
    """A pretend system for `--demo`: try the panel, or take screenshots, with nothing installed and no root.
    Start/stop/enable flip in-memory state; installs and file opens only print what would happen."""

    UNITS = {  # unit -> [active, enabled, pid, ports]
        "httpd": [True, True, 1204, (80, 443)], "php8.3-fpm": [True, True, 1211, ()],
        "mariadb": [True, False, 1388, (3306,)], "postgresql": [False, False, None, (5432,)],
        "valkey": [True, True, 1460, (6379,)],
    }
    PATHS = {"/etc/httpd/conf/httpd.conf", "/etc/my.cnf", "/etc/valkey/valkey.conf", "/etc/php-fpm.conf",
             "/var/lib/pgsql/data/postgresql.conf", "/usr/share/phpmyadmin", "/usr/share/adminer"}

    def __init__(self):
        self.units = {u: list(v) for u, v in self.UNITS.items()}

    def run(self, cmd, timeout=30):
        cmd = list(cmd[1:]) if cmd and cmd[0] in ("pkexec", "sudo") else list(cmd)
        if cmd[:2] == ["sh", "-c"]:  # the panel chains "all" actions into one shell call
            for part in cmd[2].split(" && "):
                self.run(shlex.split(part))
            return 0, "", ""
        if cmd[:2] == ["systemctl", "list-unit-files"]:
            return 0, "".join(f"{u}.service enabled enabled\n" for u in self.units), ""
        if cmd[0] == "ss":
            ports = [p for on, _, _, ps in self.units.values() if on for p in ps]
            return 0, "".join(f"LISTEN 0 128 0.0.0.0:{p} 0.0.0.0:*\n" for p in ports), ""
        if cmd[:2] == ["systemctl", "show"]:
            on, enabled, pid, _ = self.units[cmd[2]]
            return 0, (f"ActiveState={'active' if on else 'inactive'}\nSubState={'running' if on else 'dead'}\n"
                       f"UnitFileState={'enabled' if enabled else 'disabled'}\nMainPID={pid if on else 0}\n"), ""
        if cmd[:2] == ["systemctl", "try-restart"]:
            return 0, "", ""  # restarts only what already runs, so state does not change
        if cmd[0] == "systemctl" and cmd[1] in core.ACTIONS:
            unit = self.units[cmd[-1]]
            time.sleep(0.6)
            if cmd[1] in ("enable", "disable"):
                unit[1] = cmd[1] == "enable"
            unit[0] = cmd[1] != "stop" and cmd[1] != "disable"
            unit[2] = unit[2] or 4000 + len(cmd[-1])
            return 0, "", ""
        if cmd[0] == "journalctl":
            unit = cmd[cmd.index("-u") + 1]
            return 0, "\n".join(f"2026-10-20T12:0{i}:1{i}-0700 demo {unit}[{1200 + i}]: {msg}" for i, msg in enumerate(
                ["Starting service…", "Listening for connections", "Reloaded configuration", "Ready"])), ""
        return 0, "demo mode: nothing was changed", ""

    def which(self, name):
        return f"/usr/bin/{name}" if name in ("dnf", "pkexec") else None

    def exists(self, path):
        return path in self.PATHS


class App:
    def __init__(self, runner=None):
        self.runner = runner or core.Runner()
        self.demo = isinstance(self.runner, DemoRunner)
        self.token = secrets.token_urlsafe(24)
        self.console = Console()
        self.last_seen = time.time()
        self.port = None

    def run_steps(self, title, cmds, tag):
        """Run privileged commands one after another in the background, stopping at the first failure."""
        if not self.console.task.acquire(blocking=False):
            raise ValueError("another task is still running")

        def work():
            try:
                self.console.add(title, tag)
                for cmd in cmds:
                    full = core.privileged(cmd, gui=True, runner=self.runner)
                    self.console.add("$ " + " ".join(full), tag)
                    code, out, err = self.runner.run(full, timeout=1800)
                    if out.strip():
                        self.console.add(out[-6000:], tag)
                    if code != 0:
                        self.console.add(f"failed (exit {code}): {err.strip()[-2000:]}", "err")
                        return
                self.console.add("done", tag)
            finally:
                self.console.task.release()

        threading.Thread(target=work, daemon=True).start()

    def action(self, service_id, action):
        units = core.unit_files(self.runner)
        ids = [s.id for s in core.CATALOG if core.find_unit(s, units)] if service_id == "all" else [service_id]
        if not ids:
            raise ValueError("no managed services installed")
        cmds = [core.action_command(i, action, units, bulk=service_id == "all") for i in ids]
        # one pkexec per command would mean one password prompt each; chain them in a single call instead
        if len(cmds) > 1:
            cmds = [["sh", "-c", " && ".join(shlex.join(c) for c in cmds)]]
        self.run_steps(f"{action} {service_id}", cmds, service_id)

    def install_plan(self, service_id):
        return core.install_commands(service_id, core.package_manager(self.runner))

    def install(self, service_id):
        self.run_steps(f"install {service_id}", self.install_plan(service_id), service_id)

    def logs(self, service_id):
        unit = core.find_unit(core.by_id(service_id), core.unit_files(self.runner))
        if not unit:
            raise ValueError(f"{service_id} is not installed")
        code, out, err = self.runner.run(core.logs_command(unit, 200))
        if not out.strip() or "No entries" in out:
            return (out or err) + "\nNo journal entries visible. Your user may need the 'systemd-journal' group, " \
                                  "or try `crystalctl logs " + service_id + "` in a terminal."
        return out

    @staticmethod
    def theme():
        try:
            with open(SETTINGS) as f:
                return json.load(f).get("theme")
        except (OSError, ValueError):
            return None

    @staticmethod
    def set_theme(theme):
        """The port changes every launch, so browser storage would forget the choice."""
        if theme not in ("light", "dark"):
            raise ValueError("theme must be light or dark")
        os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
        with open(SETTINGS, "w") as f:
            json.dump({"theme": theme}, f)

    def open_path(self, service_id, what):
        item = next(s for s in core.status(self.runner) if s["id"] == service_id)
        path = item.get(what) if what in ("config", "log") else None
        if not path:
            raise ValueError(f"no {what} found for {service_id}")
        if self.demo:
            self.console.add(f"demo: would open {path}", service_id)
        else:
            subprocess.Popen(["xdg-open", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return path


def make_handler(app):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_):
            pass

        def send(self, code, body, ctype="application/json"):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Security-Policy",
                             "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'unsafe-inline'; "
                             "connect-src 'self'; frame-ancestors 'none'")
            self.end_headers()
            self.wfile.write(data)

        def trusted(self):
            host_ok = self.headers.get("Host") == f"127.0.0.1:{app.port}"
            token_ok = hmac.compare_digest(self.headers.get("X-Crystal-Token", ""), app.token)
            return host_ok and token_ok

        def body(self):
            n = int(self.headers.get("Content-Length") or 0)
            return json.loads(self.rfile.read(min(n, 10_000)) or b"{}")

        def do_GET(self):
            url = urlparse(self.path)
            if url.path == "/":
                for p in PANEL_PATHS:
                    if os.path.exists(p):
                        with open(p, "rb") as f:
                            return self.send(200, f.read(), "text/html; charset=utf-8")
                return self.send(500, b"panel.html not found", "text/plain")
            self.api("GET", url.path, {k: v[0] for k, v in parse_qs(url.query).items()})

        def do_POST(self):
            try:
                payload = self.body()
            except (ValueError, json.JSONDecodeError):
                return self.send(400, {"error": "bad json"})
            self.api("POST", urlparse(self.path).path, payload)

        def api(self, method, path, args):
            if not self.trusted():
                return self.send(403, {"error": "forbidden"})
            app.last_seen = time.time()
            try:
                routes = {
                    ("GET", "/api/status"): lambda: {"services": core.status(app.runner), "kinds": core.KINDS,
                                                     "pm": core.package_manager(app.runner),
                                                     "busy": app.console.busy, "theme": app.theme(),
                                                     "demo": app.demo},
                    ("GET", "/api/console"): lambda: dict(zip(("next", "lines"),
                                                              app.console.since(int(args.get("since", 0))))),
                    ("GET", "/api/logs"): lambda: {"text": app.logs(args.get("id", ""))},
                    ("GET", "/api/install-plan"): lambda: {"commands": app.install_plan(args.get("id", ""))},
                    ("POST", "/api/action"): lambda: app.action(args.get("id", ""), args.get("action", "")),
                    ("POST", "/api/install"): lambda: app.install(args.get("id", "")),
                    ("POST", "/api/open"): lambda: {"path": app.open_path(args.get("id", ""), args.get("what"))},
                    ("POST", "/api/theme"): lambda: app.set_theme(args.get("theme")),
                    ("POST", "/api/ping"): lambda: None,
                }
                if (method, path) not in routes:
                    return self.send(404, {"error": "not found"})
                return self.send(200, routes[(method, path)]() or {"ok": True})
            except (KeyError, StopIteration):
                return self.send(404, {"error": "unknown service"})
            except ValueError as e:
                return self.send(409, {"error": str(e)})

    return Handler


def open_window(url):
    """Prefer a chromeless app window; fall back to the default browser."""
    for browser in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "brave-browser",
                    "microsoft-edge"):
        if shutil.which(browser):
            subprocess.Popen([browser, f"--app={url}", "--window-size=1180,820"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    app = App(DemoRunner() if "--demo" in sys.argv else None)
    server = ThreadingHTTPServer(("127.0.0.1", 0), make_handler(app))
    app.port = server.server_address[1]
    # the token rides in the fragment, which browsers never send to servers or put in Referer
    url = f"http://127.0.0.1:{app.port}/#{app.token}"
    if "--no-window" in sys.argv:
        print(url, flush=True)
    else:
        open_window(url)

    def watchdog():
        while True:
            time.sleep(5)
            if time.time() - app.last_seen > IDLE_EXIT_SECONDS and not app.console.busy:
                server.shutdown()
                return

    threading.Thread(target=watchdog, daemon=True).start()
    app.console.add(f"panel ready on 127.0.0.1:{app.port} · package manager: "
                    f"{core.package_manager(app.runner) or 'none found'}")
    server.serve_forever()


if __name__ == "__main__":
    main()

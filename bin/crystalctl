#!/usr/bin/env python3
"""crystalctl — manage Apache, Nginx, PHP-FPM, MariaDB, MySQL, PostgreSQL, MongoDB, Redis and Memcached."""

import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [os.path.join(HERE, "..", "lib"), "/usr/local/lib/crystalctl"]
import crystal_core as core  # noqa: E402

TTY = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
RED, DIM, BOLD, GREY, NC = (("\033[38;5;196m", "\033[38;5;52m", "\033[1m", "\033[38;5;244m", "\033[0m")
                            if TTY else ("",) * 5)


def header():
    print(f"{RED}{BOLD}CRYSTAL//CTL{NC} {GREY}web · sql · nosql{NC}\n")


def die(msg):
    print(f"{RED}error:{NC} {msg}", file=sys.stderr)
    sys.exit(1)


def run_visible(cmd):
    print(f"{GREY}$ {' '.join(cmd)}{NC}")
    return subprocess.call(cmd)


def cmd_status(_args):
    header()
    rows = [s for s in core.status() if s["installed"]]
    if not rows:
        print(f"{GREY}No managed services installed. Try `crystalctl list`.{NC}")
        return
    print(f"{BOLD}{'SERVICE':<16}{'UNIT':<16}{'STATE':<12}{'BOOT':<7}{'PID':<9}PORTS{NC}")
    for s in rows:
        on = s["active"] == "active"
        state = f"{RED}● running{NC}" if on else f"{GREY}○ {s['active']}{NC}"
        pad = " " * (12 - len(f"● {'running' if on else s['active']}"))
        print(f"{s['name']:<16}{s['unit']:<16}{state}{pad}{'yes' if s['enabled'] else 'no':<7}"
              f"{s['pid'] or '-':<9}{', '.join(map(str, s['ports'])) or '-'}")


def cmd_list(_args):
    header()
    services = core.status()
    for kind, label in core.KINDS:
        print(f"{RED}{BOLD}{label}{NC}")
        for s in services:
            if s["kind"] != kind:
                continue
            if s["installed"]:
                tag = f"{RED}installed{NC}"
            elif s["installable"]:
                tag = f"{GREY}crystalctl install {s['id']}{NC}"
            else:
                tag = f"{DIM}not in this distro's repos{NC}"
            print(f"  {s['id']:<12}{s['name']:<16}{tag}")
        print()


def targets(args):
    """Named services, or every installed one when none is given."""
    units = core.unit_files(core.Runner())
    ids = args or [s.id for s in core.CATALOG if core.find_unit(s, units)]
    for i in ids:
        try:
            core.by_id(i)
        except KeyError:
            die(f"unknown service '{i}' (see `crystalctl list`)")
    return ids, units


def cmd_action(action, args):
    if action in ("enable", "disable") and not args:
        die(f"usage: crystalctl {action} <service>")
    ids, units = targets(args)
    if not ids:
        die("no managed services installed (see `crystalctl list`)")
    failed = 0
    for i in ids:
        try:
            cmd = core.action_command(i, action, units)
        except ValueError as e:
            print(f"{GREY}skip:{NC} {e}")
            continue
        failed |= run_visible(core.privileged(cmd))
    sys.exit(1 if failed else 0)


def cmd_logs(args):
    if not args:
        die("usage: crystalctl logs <service> [lines]")
    units = core.unit_files(core.Runner())
    unit = core.find_unit(core.by_id(args[0]), units) if args[0] in [s.id for s in core.CATALOG] else None
    if not unit:
        die(f"'{args[0]}' is not an installed service")
    lines = args[1] if len(args) > 1 and args[1].isdigit() else "80"
    # journal access may need the systemd-journal group; sudo covers the rest
    sys.exit(run_visible(core.privileged(core.logs_command(unit, lines))))


def cmd_install(args):
    yes = "-y" in args
    names = [a for a in args if a != "-y"]
    if len(names) != 1:
        die("usage: crystalctl install <service|phpmyadmin|adminer> [-y]")
    pm = core.package_manager(core.Runner())
    try:
        cmds = core.install_commands(names[0], pm)
    except KeyError:
        die(f"unknown service '{names[0]}' (see `crystalctl list`)")
    except ValueError as e:
        die(str(e))
    header()
    print(f"This will run with {BOLD}sudo{NC}:")
    for c in cmds:
        print(f"  {GREY}{' '.join(c)}{NC}")
    if not yes and input("\nContinue? [y/N] ").strip().lower() not in ("y", "yes"):
        print("Cancelled.")
        return
    for c in cmds:
        if run_visible(core.privileged(c)) != 0:
            die("install failed; nothing after this step was run")
    print(f"\n{RED}done.{NC} Start it with `crystalctl start {names[0]}` or at boot with `crystalctl enable {names[0]}`.")


def cmd_gui(_args):
    gui = os.path.join(HERE, "crystalctl-gui")
    subprocess.Popen([gui if os.path.exists(gui) else "crystalctl-gui"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    print("Launched CRYSTAL//CTL panel.")


def cmd_open(target):
    subprocess.Popen(["xdg-open", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_help(_args=None):
    header()
    print(f"""{BOLD}usage:{NC} crystalctl <command> [service...]

  {RED}status{NC}                  live state, boot, PID and listening ports
  {RED}list{NC}                    every supported service and how to install it
  {RED}start|stop|restart{NC} [s]  act on the named services, or all installed ones
  {RED}enable|disable{NC} <s>      start at boot (and now) / stop and remove from boot
  {RED}logs{NC} <s> [lines]        recent journal entries
  {RED}install{NC} <s> [-y]        install with apt, dnf, pacman or zypper
  {RED}gui{NC}                     open the graphical panel
  {RED}web{NC} | {RED}dir{NC}               open http://localhost | the web root
  {RED}db{NC}                      open phpMyAdmin

services: {', '.join(s.id for s in core.CATALOG)}
panels:   {', '.join(core.ADMIN_PANELS)} (install only)""")


def main(argv):
    cmd, args = (argv[0] if argv else "help"), argv[1:]
    if cmd in core.ACTIONS:
        return cmd_action(cmd, args)
    handlers = {"status": cmd_status, "list": cmd_list, "logs": cmd_logs, "log": cmd_logs,
                "install": cmd_install, "gui": cmd_gui, "help": cmd_help, "-h": cmd_help, "--help": cmd_help,
                "web": lambda _a: cmd_open("http://localhost"),
                "db": lambda _a: cmd_open("http://localhost/phpmyadmin"),
                "dir": lambda _a: cmd_open(next((d for d in ("/var/www/html", "/srv/http", "/var/www")
                                                 if os.path.isdir(d)), "/var/www"))}
    if cmd not in handlers:
        print(f"{RED}unknown command:{NC} {cmd}\n")
        cmd_help()
        sys.exit(1)
    handlers[cmd](args)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        sys.exit(130)
